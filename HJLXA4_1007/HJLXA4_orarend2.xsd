<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Időpont típusa: óra:perc formátum, pl. 8:00 vagy 14:30 -->
    <xs:simpleType name="idoTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="([01]?[0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- A hét napjai -->
    <xs:simpleType name="napTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Hetfo"/>
            <xs:enumeration value="Kedd"/>
            <xs:enumeration value="Szerda"/>
            <xs:enumeration value="Csutortok"/>
            <xs:enumeration value="Pentek"/>
            <xs:enumeration value="Szombat"/>
            <xs:enumeration value="Vasarnap"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Óra típusa -->
    <xs:simpleType name="oraFajtaTipus">
        <xs:restriction base="xs:string">
            <xs:enumeration value="eloadas"/>
            <xs:enumeration value="gyakorlat"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Egy óra időpontja -->
    <xs:complexType name="idopontTipus">
        <xs:sequence>
            <xs:element name="nap" type="napTipus"/>
            <xs:element name="tol" type="idoTipus"/>
            <xs:element name="ig" type="idoTipus"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Egy órarendi bejegyzés -->
    <xs:complexType name="oraTipus">
        <xs:sequence>
            <xs:element name="targy" type="xs:string"/>
            <xs:element name="idopont" type="idopontTipus"/>
            <xs:element name="helyszin" type="xs:string"/>
            <xs:element name="oktato" type="xs:string"/>
            <xs:element name="szak" type="xs:string"/>
        </xs:sequence>

        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="tipus" type="oraFajtaTipus" use="required"/>
    </xs:complexType>

    <!-- Az órarend gyökéreleme -->
    <xs:element name="MVB_orarend">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ora" type="oraTipus" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
